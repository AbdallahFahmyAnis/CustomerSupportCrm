# Copy to .env for local overrides (do not commit real secrets).
CRM_MSSQL_SA_PASSWORD=Crm_Local_Sql_2026!
CRM_POSTGRES_USER=crm
CRM_POSTGRES_PASSWORD=Crm_Local_Pg_2026!
CRM_POSTGRES_DB=crm_channels
CRM_MONGO_USER=crm
CRM_MONGO_PASSWORD=Crm_Local_Mongo_2026!

# —— Twilio trial (SMS + WhatsApp) — Channels service (CRM-040) ——
# Copy this file to `.env` at the repo root, fill values, restart Channels (:5201).
# Console: https://console.twilio.com → Account SID + Auth Token
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# Trial SMS From (Phone Numbers → Active numbers, E.164):
# TWILIO_SMS_FROM=+1xxxxxxxxxx
# WhatsApp sandbox From (Messaging → Try it out → WhatsApp):
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL Twilio calls for inbound (use ngrok https URL in trial):
# CHANNELS_PUBLIC_URL=https://YOUR_SUBDOMAIN.ngrok-free.app
#
# Twilio Console webhooks (POST, form-urlencoded):
#   SMS:      {CHANNELS_PUBLIC_URL}/api/channels/webhooks/twilio/sms
#   WhatsApp: {CHANNELS_PUBLIC_URL}/api/channels/webhooks/twilio/whatsapp
#
# Trial limits: SMS/WhatsApp only to verified numbers; join WhatsApp sandbox first.

# —— Twilio SendGrid (email outbound) ——
# Email uses SendGrid (Twilio’s email product), not TWILIO_ACCOUNT_SID.
# 1) https://app.sendgrid.com → Settings → API Keys → Create (Mail Send)
# 2) Settings → Sender Authentication → verify a single sender or domain
# SENDGRID_API_KEY=SG.xxxxxxxx
# SENDGRID_FROM=support@your-verified-domain.com
# Aliases also accepted: TWILIO_SENDGRID_API_KEY / TWILIO_SENDGRID_FROM

# Identity (host → published SQL Server port)
# ConnectionStrings__Identity=Server=localhost,1433;User Id=sa;Password=Crm_Local_Sql_2026!;TrustServerCertificate=True;Initial Catalog=CrmIdentity
# Identity__Provider=SqlServer

# Channels TypeORM → Postgres
# CHANNELS_DATABASE_URL=postgres://crm:Crm_Local_Pg_2026!@localhost:5432/crm_channels
