{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Identity": "http://localhost:5101",
    "Customers": "http://localhost:5102",
    "Tickets": "http://localhost:5103",
    "Channels": "http://localhost:5201",
    "Notifications": "http://localhost:5202"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-api": {
        "ClusterId": "identity",
        "Order": 1,
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "customers-api": {
        "ClusterId": "customers",
        "Order": 1,
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "tickets-api": {
        "ClusterId": "tickets",
        "Order": 1,
        "Match": { "Path": "/api/tickets/{**catch-all}" }
      },
      "channels-api": {
        "ClusterId": "channels",
        "Order": 1,
        "Match": { "Path": "/api/channels/{**catch-all}" }
      },
      "notifications-api": {
        "ClusterId": "notifications",
        "Order": 1,
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "agent-mfe": {
        "ClusterId": "agent-mfe",
        "Order": 2,
        "Match": { "Path": "/mfe/agent/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/mfe/agent" }
        ]
      },
      "portal-mfe": {
        "ClusterId": "portal-mfe",
        "Order": 2,
        "Match": { "Path": "/mfe/portal/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/mfe/portal" }
        ]
      },
      "admin-mfe": {
        "ClusterId": "admin-mfe",
        "Order": 2,
        "Match": { "Path": "/mfe/admin/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/mfe/admin" }
        ]
      },
      "knowledge-mfe": {
        "ClusterId": "knowledge-mfe",
        "Order": 2,
        "Match": { "Path": "/mfe/knowledge/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/mfe/knowledge" }
        ]
      },
      "shell": {
        "ClusterId": "shell",
        "Order": 100,
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101/" }
        }
      },
      "customers": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102/" }
        }
      },
      "tickets": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5103/" }
        }
      },
      "channels": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5201/" }
        }
      },
      "notifications": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5202/" }
        }
      },
      "shell": {
        "Destinations": {
          "d1": { "Address": "http://localhost:4200/" }
        }
      },
      "agent-mfe": {
        "Destinations": {
          "d1": { "Address": "http://localhost:4201/" }
        }
      },
      "portal-mfe": {
        "Destinations": {
          "d1": { "Address": "http://localhost:4202/" }
        }
      },
      "admin-mfe": {
        "Destinations": {
          "d1": { "Address": "http://localhost:4203/" }
        }
      },
      "knowledge-mfe": {
        "Destinations": {
          "d1": { "Address": "http://localhost:4204/" }
        }
      }
    }
  }
}
